{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "roya/**",
          "templates/**",
          "static/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/cron/operations-scan",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/internal/cron/send-notifications",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/internal/cron/send-reminders",
      "schedule": "0 6 * * *"
    }
  ]
}
