{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "roya/**",
          "templates/**",
          "static/**"
        ]
      }
    }
  ],
  "routes": [
    {"src": "/(.*)", "dest": "app.py"}
  ],
  "crons": [
    {"path": "/api/internal/cron/payment-reconcile", "schedule": "30 2 * * *"},
    {"path": "/api/internal/cron/send-reminders", "schedule": "0 6 * * *"}
  ]
}
